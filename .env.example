# Copy to .env or export these variables. No secrets are committed.

# Database. Default is a local SQLite file (zero setup).
# For PostgreSQL (e.g. via docker-compose), use:
#   DATABASE_URL=postgresql+psycopg2://careeros:careeros@localhost:5432/careeros
DATABASE_URL=sqlite:///./careeros.db

# Claude API. Without a key the app runs in OFFLINE mode: every feature works
# with deterministic local logic, and AI-generated steps are clearly labelled.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# auto: use Claude when a key is present, else offline. claude: require key. offline: never call the API.
LLM_MODE=auto

# Where uploads are stored.
DATA_DIR=./data
